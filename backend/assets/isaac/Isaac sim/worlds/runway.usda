    )
    {
        quatd xformOp:orient = (0.7071067811865476, 0, 0, 0.7071067811865476)
        double3 xformOp:translate = (0, 0, 0.31)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

