    def Camera "ChaseCamera"
    {
        float exposure = 0
        float exposure:fStop = 5
        float exposure:iso = 100
        float exposure:time = 0.008
        float2 clippingRange = (0.05, 20000)
        float focalLength = 24
        matrix4d xformOp:transform = ( (1, 0, -0, 0), (0, 0.3846153846153845, 0.9230769230769229, 0), (0, -0.9230769230769229, 0.3846153846153845, 0), (0, -5.999999999999998, 2.7499999999999996, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def Xform "Aircraft" (
