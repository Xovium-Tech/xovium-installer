        )
        bool physics:collisionEnabled = 1
        color3f[] primvars:displayColor = [(0.16, 0.26, 0.13)]
        double size = 1
        float3 xformOp:scale = (10000, 10000, 0.2)
        double3 xformOp:translate = (0, 0, -0.15)
