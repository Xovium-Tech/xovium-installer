[package]
title = "Isaac Sim Native Fixed Wing"
version = "1.0.0"
[dependencies]
"omni.kit.mainwindow" = {}
"omni.kit.viewport.window" = {}
"omni.kit.viewport.menubar.camera" = {}
"omni.kit.viewport.menubar.lighting" = {}
"omni.kit.viewport.menubar.render" = {}
"omni.kit.viewport.menubar.settings" = {}
"omni.kit.viewport.manipulator.transform" = {}
"omni.kit.manipulator.selection" = {}
"omni.kit.window.stage" = {}
"omni.kit.window.property" = {}
"omni.kit.property.usd" = {}
"omni.kit.property.physics" = {}
"omni.kit.window.toolbar" = {}
"omni.kit.window.file" = {}
"omni.hydra.rtx" = {}
"omni.physx" = {}
"px4.isaac.flight" = {}
"px4.isaac.terrain" = {}
"px4.isaac.camera" = {}
[settings]
app.name = "px4.isaac.native"
app.version = "1.0.0"
app.window.title = "Isaac Sim - Native C++ Fixed Wing"
app.window.width = 1280
app.window.height = 720
app.vulkan = true
app.fastShutdown = true
app.settings.persistent = false
app.settings.fabricDefaultStageFrameHistoryCount = 3
app.runLoops.main.rateLimitEnabled = false
app.renderer.resolution.width = 1280
app.renderer.resolution.height = 720
renderer.multiGpu.enabled = false
renderer.activeGpu = 0
persistent.renderer.startupMessageDisplayed = true
renderer.enabled = "rtx"
rtx.rendermode = "RealTimePathTracing"
rtx.translucency.enabled = false
rtx.reflections.enabled = false
rtx.indirectDiffuse.enabled = false
app.viewport.defaultCamera = "/World/ChaseCamera"
app.exts.registryEnabled = false
px4.flight.externalTick = true
physics.updateToUsd = true
physics.updateVelocitiesToUsd = false
px4.terrain.enabled = true
