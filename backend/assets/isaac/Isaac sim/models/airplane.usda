#usda 1.0
(
    defaultPrim = "Aircraft"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Aircraft" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.19, 0.08, 0.25)
    bool physics:kinematicEnabled = 0
    float physics:mass = 1.5
    quatf physics:principalAxes = (1, 0, 0, 0)
    bool physics:rigidBodyEnabled = 1

    def "Materials"
    {
        def Material "Body" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0.05
            float physics:staticFriction = 0.5
        }

        def Material "Gear" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.025
            float physics:restitution = 0
            float physics:staticFriction = 0.025
        }
    }

    def Cube "Fuselage" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Aircraft/Materials/Body> (
            bindMaterialAs = "weakerThanDescendants"
        )
        bool physics:collisionEnabled = 1
        color3f[] primvars:displayColor = [(0.85, 0.87, 0.9)]
        double size = 1
        float3 xformOp:scale = (1.15, 0.12, 0.16)
        double3 xformOp:translate = (-0.025, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Wing" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Aircraft/Materials/Body> (
            bindMaterialAs = "weakerThanDescendants"
        )
        bool physics:collisionEnabled = 1
        color3f[] primvars:displayColor = [(0.15, 0.35, 0.8)]
        double size = 1
        float3 xformOp:scale = (0.3, 1.5, 0.03)
        double3 xformOp:translate = (0, 0, 0.045)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Tail" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Aircraft/Materials/Body> (
            bindMaterialAs = "weakerThanDescendants"
        )
        bool physics:collisionEnabled = 1
        color3f[] primvars:displayColor = [(0.15, 0.35, 0.8)]
        double size = 1
        float3 xformOp:scale = (0.18, 0.5, 0.025)
        double3 xformOp:translate = (-0.49, 0, 0.035)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Fin" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
