    def Sphere "LeftGear" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Aircraft/Materials/Gear> (
            bindMaterialAs = "weakerThanDescendants"
        )
        bool physics:collisionEnabled = 1
        color3f[] primvars:displayColor = [(0.055, 0.055, 0.055)]
        double radius = 0.07
        double3 xformOp:translate = (-0.09, 0.25, -0.22)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "LeftGearStrut"
    {
        color3f[] primvars:displayColor = [(0.4, 0.4, 0.45)]
        double size = 1
        float3 xformOp:scale = (0.015, 0.015, 0.12)
        double3 xformOp:translate = (-0.09, 0.25, -0.13)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Sphere "RightGear" (
