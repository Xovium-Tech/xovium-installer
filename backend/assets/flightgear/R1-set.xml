<?xml version="1.0"?>
<PropertyList>
  <sim>
    <description>Xovium shared R1 differential rover</description>
    <author>Xovium</author>
    <flight-model>null</flight-model>
    <model><path>Aircraft/r1_rover/model.ac</path></model>
    <view n="0">
      <name>Rover chase</name><type>lookat</type>
      <config><from-model type="bool">false</from-model><at-model type="bool">false</at-model>
        <eye-lat-deg-path>/position/latitude-deg</eye-lat-deg-path>
        <eye-lon-deg-path>/position/longitude-deg</eye-lon-deg-path>
        <eye-alt-ft-path>/position/altitude-ft</eye-alt-ft-path>
        <target-lat-deg-path>/position/latitude-deg</target-lat-deg-path>
        <target-lon-deg-path>/position/longitude-deg</target-lon-deg-path>
        <target-alt-ft-path>/position/altitude-ft</target-alt-ft-path>
        <eye-heading-deg-path>/orientation/heading-deg</eye-heading-deg-path>
        <x-offset-m>0</x-offset-m><y-offset-m>1.5</y-offset-m><z-offset-m>-4</z-offset-m>
        <default-field-of-view-deg>55</default-field-of-view-deg>
      </config>
    </view>
  </sim>
</PropertyList>
